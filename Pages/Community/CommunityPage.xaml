<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HuFu.Pages.CommunityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HuFu.Pages"
    xmlns:converters="using:HuFu.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:RefererImageConverter x:Key="RefererImageConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Grid Grid.Row="0" Padding="24,16">
            <TextBlock Text="社区" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <!-- Pivot 标签页 -->
        <Pivot Grid.Row="1" Margin="16,0">
            <!-- 热门 -->
            <PivotItem Header="热门">
                <Grid>
                    <!-- 加载指示器 -->
                    <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                  Width="40"
                                  Height="40"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="{x:Bind IsLoading, Mode=OneWay}" />

                    <!-- 文章列表 -->
                    <ScrollViewer x:Name="PostScrollViewer"
                                  ViewChanged="PostScrollViewer_ViewChanged"
                                  Visibility="{x:Bind IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=False}">
                        <ItemsRepeater ItemsSource="{x:Bind RecommendPosts, Mode=OneWay}"
                                       Margin="0,8">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:PostDisplayItem">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Tapped="PostItem_Tapped"
                                            Tag="{x:Bind Id, Mode=OneWay}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 作者信息 -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                                <PersonPicture Width="32" 
                                                               Height="32"
                                                               ProfilePicture="{x:Bind SenderAvatar, Mode=OneWay, Converter={StaticResource RefererImageConverter}}"
                                                               DisplayName="{x:Bind SenderNickname, Mode=OneWay}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{x:Bind SenderNickname, Mode=OneWay}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14" />
                                                        <Border Background="#FFD700"
                                                                CornerRadius="4"
                                                                Padding="4,2"
                                                                Visibility="{x:Bind IsVip, Mode=OneWay}">
                                                            <TextBlock Text="VIP"
                                                                       FontSize="10"
                                                                       Foreground="White"
                                                                       FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind CreateTime, Mode=OneWay}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 文章标题 -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{x:Bind Title, Mode=OneWay}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- 文章内容预览 -->
                                            <TextBlock Grid.Row="2"
                                                       Text="{x:Bind Content, Mode=OneWay}"
                                                       FontSize="14"
                                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,12"
                                                       MaxLines="3"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- 互动数据 -->
                                            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE8E1;" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                                    <TextBlock Text="{x:Bind LikeNum, Mode=OneWay}"
                                                               FontSize="13"
                                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE8F2;" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                                    <TextBlock Text="{x:Bind CommentNum, Mode=OneWay}"
                                                               FontSize="13"
                                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE734;" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                                    <TextBlock Text="{x:Bind CollectNum, Mode=OneWay}"
                                                               FontSize="13"
                                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <!-- 全部 -->
            <PivotItem Header="全部">
                <Grid Padding="8">
                    <TextBlock Text="全部分区内容" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                </Grid>
            </PivotItem>

            <!-- 关注 -->
            <PivotItem Header="关注">
                <Grid Padding="8">
                    <TextBlock Text="关注分区内容" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                </Grid>
            </PivotItem>

            <!-- 更多 -->
            <PivotItem Header="更多">
                <ScrollViewer>
                    <StackPanel Padding="8" Spacing="8">
                        <!-- 我的文章 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="{ThemeResource SystemAccentColor}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="我的文章" FontWeight="SemiBold" />
                                    <TextBlock Text="查看和管理我发布的文章" 
                                               FontSize="12" 
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 查看推荐文章 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8E1;" FontSize="20" Foreground="{ThemeResource SystemAccentColor}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="查看推荐文章" FontWeight="SemiBold" />
                                    <TextBlock Text="浏览社区推荐文章列表" 
                                               FontSize="12" 
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 我的收藏 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE734;" FontSize="20" Foreground="{ThemeResource SystemAccentColor}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="我的收藏" FontWeight="SemiBold" />
                                    <TextBlock Text="查看我收藏的文章" 
                                               FontSize="12" 
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 被屏蔽的用户 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE72E;" FontSize="20" Foreground="{ThemeResource SystemAccentColor}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="被屏蔽的用户" FontWeight="SemiBold" />
                                    <TextBlock Text="管理已屏蔽的用户列表" 
                                               FontSize="12" 
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 新建分区 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE710;" FontSize="20" Foreground="{ThemeResource SystemAccentColor}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="新建分区" FontWeight="SemiBold" />
                                    <TextBlock Text="创建一个新的文章分区" 
                                               FontSize="12" 
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
